<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.youthpathtalk.post.biz.mapper.CommentLikeRecordMapper">
    <delete id="deleteByPostIds">

        delete clr
        from t_comment_like_record clr
        inner join t_comment c
        on clr.comment_id = c.id

        where c.post_id in
        <foreach collection="postIds"
                 item="id"
                 open="("
                 separator=","
                 close=")">
            #{id}
        </foreach>

    </delete>
</mapper>

