<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.neu.youthpathtalk.user.biz.mapper.UserMapper">
    <sql id="Base_Column_List">
        id,username,`password`,phone,avatar,gender,`type`,target,intro,university_id,`status`,create_time,update_time
    </sql>
    <insert id="insertSelective" parameterType="com.neu.youthpathtalk.user.biz.entity.UserDO">
        insert into t_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">
                id,
            </if>
            <if test="username != null">
                username,
            </if>
            <if test="password != null">
                `password`,
            </if>
            <if test="phone != null">
                phone,
            </if>
            <if test="avatar != null">
                avatar,
            </if>
            <if test="gender != null">
                gender,
            </if>
            <if test="type != null">
                `type`,
            </if>
            <if test="target != null">
                target,
            </if>
            <if test="intro != null">
                intro,
            </if>
            <if test="universityId != null">
                university_id,
            </if>
            <if test="status != null">
                `status`,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">
                #{id,jdbcType=BIGINT},
            </if>
            <if test="username != null">
                #{username,jdbcType=VARCHAR},
            </if>
            <if test="password != null">
                #{password,jdbcType=VARCHAR},
            </if>
            <if test="phone != null">
                #{phone,jdbcType=VARCHAR},
            </if>
            <if test="avatar != null">
                #{avatar,jdbcType=VARCHAR},
            </if>
            <if test="gender != null">
                #{gender,jdbcType=TINYINT},
            </if>
            <if test="type != null">
                #{type,jdbcType=TINYINT},
            </if>
            <if test="target != null">
                #{target,jdbcType=VARCHAR},
            </if>
            <if test="intro != null">
                #{intro,jdbcType=VARCHAR},
            </if>
            <if test="universityId != null">
                #{universityId,jdbcType=BIGINT},
            </if>
            <if test="status != null">
                #{status,jdbcType=TINYINT},
            </if>
        </trim>
    </insert>
    <update id="batchDecrTotalLikeCount">
        UPDATE t_user
        SET total_like_count = total_like_count-CASE id
        <foreach collection="userDeltas.entrySet()" index="userId" item="delta">
            WHEN #{userId} THEN #{delta}
        </foreach>
        END
        WHERE id IN
        <foreach collection="userDeltas.keySet()" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </update>
    <select id="selectUserWeeklyRankInfoByIds" resultType="com.neu.youthpathtalk.user.biz.dto.UserWeeklyRankInfoDTO">
        select id,username,avatar,university_id,type
        FROM t_user
        WHERE status = 1
        AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>

