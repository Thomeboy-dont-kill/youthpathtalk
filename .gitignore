# ========== 之前 .idea/ 下的规则 ==========
# Default ignored files (IntelliJ IDEA)
/shelf/
/workspace.xml
# Editor-based HTTP Client requests
/httpRequests/
# Datasource local storage ignored files
/dataSources/
/dataSources.local.xml

# ========== 编译产物 ==========
target/
*.class
*.jar
*.war

# ========== Maven Wrapper（保留 jar，忽略其他） ==========
!.mvn/wrapper/maven-wrapper.jar
.mvn/
mvnw
mvnw.cmd

# ========== IDE 配置 ==========
### IntelliJ IDEA ###
.idea/
*.iml
*.iws
*.ipr
out/

### Eclipse ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/

# ========== 日志与临时文件 ==========
*.log
*.tmp

# ========== 敏感配置文件（非常重要！） ==========
application.yml
application-dev.yml
.env

# ========== HTTP Requests ==========
*.http
generated-requests.http

